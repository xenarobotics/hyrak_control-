# ── Dependencies / build output ──────────────────────────────
backend/.venv/
frontend/node_modules/
frontend/.next/
frontend/out/
__pycache__/
*.py[cod]

# ── Desktop app (Electron) build output ──────────────────────
desktop/node_modules/
desktop/dist/
desktop/release/

# ── Standalone relay executable builds (PyInstaller) ─────────
sitl_relay/dist/
sitl_relay/build/

# ── Desktop app installers served at /releases — CI-uploaded, not source ─
releases/*
!releases/.gitkeep

# ── Secrets — never commit ───────────────────────────────────
.env
.env.local
# Timestamped backups (.env.bak.20260805-234333 and friends). These were NOT
# covered before and sat one `git add .` away from publishing every token in
# the file.
.env.bak*
.env.*.bak
*.env.backup
*.env.local

# ── Logs ─────────────────────────────────────────────────────
.logs/
*.log

# ── Captured data (plate crop images — retained on disk, referenced by ─────
# ── plate_events rows in Postgres; not source, not committed) ───────────────
backend/.data/
# Runtime capture data at the repo root too — plate crops, enrolment shots,
# face gallery originals. Referenced by DB rows, backed up separately (see
# docs/DISASTER_RECOVERY.md), never source.
.data/
# Loose working folders that are inputs/outputs, not source.
error images/
sample human faces/
air_unit_relay.zip

# ── Vendored upstream sources (huge; not our code) ───────────
PX4-Autopilot-main/
qgroundcontrol-master/
ADOSMissionControl-main/

# ── Stray junk from an old copy (safe to delete) ─────────────
frontend/home/

# ── Model weights (large binaries; re-download instead) ──────
*.pt

# ── Editor / OS ──────────────────────────────────────────────
.vscode/
.claude/settings.local.json
.DS_Store
