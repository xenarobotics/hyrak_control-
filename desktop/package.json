{
  "name": "hyrak-desktop",
  "version": "0.1.57",
  "description": "HYRAK desktop app — same site, plus native hardware access (UDP/TCP relays, serial, RTSP) for SITL, swarms, custom air units and multi-camera setups that a browser tab can't reach directly.",
  "author": "Xena Robotics",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "icons": "python3 build/generate-icon.py && node build/build-icons.js",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always",
    "deploy:local": "npm run release && node build/deploy-local.js",
    "ffmpeg:clean": "node -e \"require('fs').rmSync('node_modules/ffmpeg-static/ffmpeg',{force:true})\"",
    "ffmpeg:win": "npm_config_platform=win32 npm_config_arch=x64 node node_modules/ffmpeg-static/install.js",
    "ffmpeg:linux:x64": "npm run ffmpeg:clean && npm_config_platform=linux npm_config_arch=x64 node node_modules/ffmpeg-static/install.js",
    "ffmpeg:linux:arm64": "npm run ffmpeg:clean && npm_config_platform=linux npm_config_arch=arm64 node node_modules/ffmpeg-static/install.js",
    "dist:win": "npm run build && npm run ffmpeg:win && electron-builder --win --publish never",
    "dist:linux:arm64": "npm run build && npm run ffmpeg:linux:arm64 && electron-builder --linux AppImage --arm64 --publish never && npm run ffmpeg:linux:x64",
    "release:win": "npm run build && npm run ffmpeg:win && electron-builder --win --publish always",
    "release:linux:arm64": "npm run build && npm run ffmpeg:linux:arm64 && electron-builder --linux AppImage --arm64 --publish always && npm run ffmpeg:linux:x64"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.3.0",
    "serialport": "^12.0.0",
    "werift": "^0.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "icon-gen": "^5.0.0",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "com.xenarobotics.hyrak",
    "productName": "HYRAK",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      {
        "from": "node_modules/@shinyoshiaki/binary-data/src/node_modules",
        "to": "node_modules/@shinyoshiaki/binary-data/src/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "icon": "build/icon",
    "afterPack": "build/afterPack.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://api.xenarobotics.com/releases/",
        "channel": "latest"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "HYRAK-Setup-${version}.${ext}",
      "files": [
        "!node_modules/@serialport/bindings-cpp/build/**",
        "!node_modules/ffmpeg-static/ffmpeg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "HYRAK-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "HYRAK-${version}-${arch}.${ext}",
      "files": [
        "!node_modules/ffmpeg-static/ffmpeg.exe"
      ]
    }
  }
}
