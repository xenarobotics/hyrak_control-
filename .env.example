# Copy this to .env and fill in values
# Never commit .env to git

# Server
#
# Sign-in (backend/app/auth, docs/AUTH.md). Users live in Postgres and are
# created with `python -m app.auth.cli create-user <name> --role admin`.
# The two HYRAK_ADMIN_* lines are the bootstrap: an admin that exists on
# every start, database or not. The hash comes from
# `python -m app.auth.cli hash-password` - never a plaintext password here.
HYRAK_ADMIN_USER=
HYRAK_ADMIN_PASSWORD_HASH=
# The old shared token. Off by default; AUTH_LEGACY_TOKEN_ENABLED=true lets
# scripts that still send X-Auth-Token / {token: SECRET_TOKEN} act as an
# operator while they are moved to user tokens. The published default
# value is refused whatever this says, so if you turn it on set a random
# SECRET_TOKEN (python3 -c "import secrets; print(secrets.token_urlsafe(32))").
AUTH_LEGACY_TOKEN_ENABLED=false
SECRET_TOKEN=
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info

# CORS - comma separated origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Vision
DEFAULT_YOLO_MODEL=yolov8n.pt
INFERENCE_RESIZE_WIDTH=640
MAX_CONCURRENT_SESSIONS=4

# GPU - leave blank to auto-detect
# CUDA_VISIBLE_DEVICES=0
# FORCE_CPU=false

# Telemetry
DEFAULT_BAUD_RATE=57600
MAVSDK_SERVER_HOST=localhost
MAVSDK_SERVER_PORT=50051

# PX4 SITL (for development)
SITL_ADDRESS=udp://:14540

# Local Postgres (Supabase/RDS later = just change this URL)
DATABASE_URL=postgresql+asyncpg://hyrak:hyrak_dev@127.0.0.1:5432/hyrak
